{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kvarta",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "kvarta_db",
      "database_name": "kvarta-db",
      "database_id": "be2e0cf9-bdb3-4f93-9308-d09163d95b24"
    }
  ]
}
